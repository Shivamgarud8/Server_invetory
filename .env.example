# =============================================================================
#  TagID Infra Manager — configuration
#  cp .env.example .env && chmod 600 .env      (never commit .env)
#
#  Everything else is automatic:
#   - security keys are generated on first start  (./scripts/show-secrets.sh to back up)
#   - first login: user "admin", password printed in
#       docker compose logs tagid-portal-backend | grep "FIRST ADMIN"
# =============================================================================

# --- This server (where the portal runs) -------------------------------------
# Shown in the top bar so you know which deployment you are on
SERVER_LABEL=srv-106
# Address users open in the browser (no trailing slash)
PUBLIC_URL=https://10.80.0.106
# Interface + ports nginx listens on (use the private IP to keep it internal)
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80

# --- Database server (PostgreSQL) --------------------------------------------
# Host as seen from the backend container:
#   other machine → its IP   |   same machine → this server's private IP
#   bundled container (--profile bundled-db) → tagid-portal-postgres
DB_HOST=10.80.0.106
DB_PORT=5432
DB_NAME=tagid_infra_manager
DB_USER=infra_manager_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# PostgreSQL superuser — only used once by ./scripts/setup-db.sh. Remove after setup.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# --- Application --------------------------------------------------------------
APP_NAME=TagID Infra Manager
TZ=Asia/Kolkata
# light | dark | system
DEFAULT_THEME=system
